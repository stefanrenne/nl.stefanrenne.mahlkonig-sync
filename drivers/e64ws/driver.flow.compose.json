{
  "triggers": [
    {
      "id": "grind_completed",
      "title": {
        "en": "Grind completed",
        "nl": "Maalbeurt voltooid"
      },
      "hint": {
        "en": "Fires once for every grind, purges included. Use the \"Is purge\" token to leave purges out, and \"Portafilter detected\" to tell grinds started by inserting the portafilter from grinds started with the button.",
        "nl": "Gaat één keer af voor elke maalbeurt, ook voor purges. Gebruik de token \"Is purge\" om purges over te slaan, en \"Portafilter gedetecteerd\" om maalbeurten die starten door de portafilter erin te schuiven te onderscheiden van maalbeurten die met de knop starten."
      },
      "tokens": [
        {
          "name": "dose",
          "type": "number",
          "title": {
            "en": "Dose (g)",
            "nl": "Dosis (g)"
          },
          "example": 18.1
        },
        {
          "name": "grind_setting",
          "type": "number",
          "title": {
            "en": "Grind setting",
            "nl": "Maalstand"
          },
          "example": 140
        },
        {
          "name": "grind_time",
          "type": "number",
          "title": {
            "en": "Grind time (s)",
            "nl": "Maaltijd (s)"
          },
          "example": 7.9
        },
        {
          "name": "portafilter_detected",
          "type": "boolean",
          "title": {
            "en": "Portafilter detected",
            "nl": "Portafilter gedetecteerd"
          },
          "example": true
        },
        {
          "name": "is_purge",
          "type": "boolean",
          "title": {
            "en": "Is purge",
            "nl": "Is purge"
          },
          "example": false
        }
      ]
    },
    {
      "id": "shot_completed",
      "title": {
        "en": "Shot completed",
        "nl": "Shot voltooid"
      },
      "hint": {
        "en": "Fires when the paired Sync Scale reports a shot. Dose and ratio come from the grind the Mahlkönig Sync cloud links to the shot, and are 0 when there is none.",
        "nl": "Gaat af wanneer de gekoppelde Sync Scale een shot meldt. Dosis en verhouding komen van de maalbeurt die de Mahlkönig Sync-cloud aan de shot koppelt, en zijn 0 als die er niet is."
      },
      "tokens": [
        {
          "name": "yield",
          "type": "number",
          "title": {
            "en": "Yield (g)",
            "nl": "Yield (g)"
          },
          "example": 36.4
        },
        {
          "name": "shot_time",
          "type": "number",
          "title": {
            "en": "Shot time (s)",
            "nl": "Shottijd (s)"
          },
          "example": 27.5
        },
        {
          "name": "dose",
          "type": "number",
          "title": {
            "en": "Dose (g)",
            "nl": "Dosis (g)"
          },
          "example": 18.1
        },
        {
          "name": "ratio",
          "type": "number",
          "title": {
            "en": "Ratio",
            "nl": "Verhouding"
          },
          "example": 2.01
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "last_grind_within",
      "title": {
        "en": "Last grind was less than … minutes ago",
        "nl": "Laatste maalbeurt was minder dan … minuten geleden"
      },
      "titleFormatted": {
        "en": "Last grind was !{{less|more}} than [[minutes]] minutes ago",
        "nl": "Laatste maalbeurt was !{{minder|meer}} dan [[minutes]] minuten geleden"
      },
      "hint": {
        "en": "Purges don't count.",
        "nl": "Purges tellen niet mee."
      },
      "args": [
        {
          "name": "minutes",
          "type": "number",
          "title": {
            "en": "Minutes",
            "nl": "Minuten"
          },
          "min": 1,
          "max": 1440,
          "step": 1,
          "placeholder": {
            "en": "minutes",
            "nl": "minuten"
          }
        }
      ]
    }
  ]
}
